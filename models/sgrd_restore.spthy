theory SGRD_Restore
begin

/*
  SGRD 온라인 복원(알고리즘 1)의 기호적 모델.
  - 보유자 두 명(H1, H2)이 K_e 의 조각을 하나씩 가진다(2-of-2 로 추상화한 임계 재암호화).
    각 보유자는 플랫폼이 회차마다 만든 임시 공개키 pk(e) 아래로 자기 조각을 암호화해 내놓는다.
  - 플랫폼의 복원 요청은 플랫폼 증명 키(AK, PUF 결속, 무력화 뒤에도 남음: PR4)로 서명된다.
  - 관리권 증명 발급자(I)는 그 회차의 (선박, epoch, 논스)에 서명한다. 발급자는 관리권이 실제로
    돌아왔을 때만 서명한다고 보고, 그 판단을 CustodyRegained 사건으로 표시한다.
  - R0: 플랫폼은 두 보유자의 토큰 서명과 관리권 증명을 모두 확인한 뒤에만 조각을 받아들인다.
  - 회차는 두 번(epoch ep1, ep2)으로 한정한다. 둘째 회차는 첫 회차의 토큰 재사용을 시험하는 자리다.
  - 공격자는 망 전체를 쥐며(Dolev-Yao), 보유자·발급자·AK 를 각각 훼손할 수 있다.
*/

builtins: asymmetric-encryption, signing, hashing

rule Holder_Init:
  [ Fr(~sk) ] --[ HolderInit($H) ]-> [ !LtkH($H, ~sk), !PkH($H, pk(~sk)), Out(pk(~sk)) ]

rule Issuer_Init:
  [ Fr(~sk) ] --[ IssuerInit($I) ]-> [ !LtkI($I, ~sk), !PkI($I, pk(~sk)), Out(pk(~sk)) ]

rule Register:
  [ Fr(~ak), Fr(~p1), Fr(~p2), Fr(~ep1), Fr(~ep2),
    !PkH($H1, pk1), !PkH($H2, pk2), !PkI($I, pkI) ]
  --[ KeyOf($S, $H1, $H2, <~p1, ~p2>), Neq($H1, $H2), Once($S) ]->
  [ !AK($S, ~ak), !PkAK($S, pk(~ak)), Out(pk(~ak)),
    !Share($H1, $S, $I, ~p1), !Share($H2, $S, $I, ~p2),
    !Cfg($S, $H1, $H2, $I),
    Ep1($S, ~ep1, ~ep2), Out(<~ep1, ~ep2>) ]

rule Corrupt_Holder:
  [ !LtkH($H, sk), !Share($H, S, I, p) ] --[ CorruptH($H) ]-> [ Out(<sk, p>) ]

rule Corrupt_Issuer:
  [ !LtkI($I, sk) ] --[ CorruptI($I) ]-> [ Out(sk) ]

rule Corrupt_AK:
  [ !AK($S, ak) ] --[ CorruptAK($S) ]-> [ Out(ak) ]

/* 복원 요청. 첫 회차(Ep1)와 둘째 회차(Ep2)를 다른 사실로 두어 역방향 탐색이 되먹임되지 않게 한다 */
rule Platform_Request_1:
  [ Ep1(S, ep, nxt), !AK(S, ak), Fr(~n), Fr(~e), Fr(~hsafe), Fr(~hatt) ]
  --[ Request(S, ep, ~n, pk(~e)) ]->
  [ Waiting1(S, ep, nxt, ~n, ~e, ~hsafe, ~hatt),
    Out(<<'req', S, ep, ~n, ~hsafe, ~hatt, pk(~e)>, sign(<'req', S, ep, ~n, ~hsafe, ~hatt, pk(~e)>, ak)>) ]

rule Platform_Request_2:
  [ Ep2(S, ep), !AK(S, ak), Fr(~n), Fr(~e), Fr(~hsafe), Fr(~hatt) ]
  --[ Request(S, ep, ~n, pk(~e)) ]->
  [ Waiting2(S, ep, ~n, ~e, ~hsafe, ~hatt),
    Out(<<'req', S, ep, ~n, ~hsafe, ~hatt, pk(~e)>, sign(<'req', S, ep, ~n, ~hsafe, ~hatt, pk(~e)>, ak)>) ]

rule Issuer_Custody:
  [ !LtkI(I, skI), In(<S, ep, n>) ]
  --[ CustodyRegained(I, S, ep, n) ]->
  [ Out(sign(<'cust', S, ep, n>, skI)) ]

rule Holder_Release:
  [ !LtkH(H, skH), !Share(H, S, I, p), !PkAK(S, pkak), !PkI(I, pkI),
    In(<<'req', S, ep, n, hs, ha, pke>, rsig, cust>) ]
  --[ Eq(verify(rsig, <'req', S, ep, n, hs, ha, pke>, pkak), true),
      Eq(verify(cust, <'cust', S, ep, n>, pkI), true),
      HolderSigned(H, S, ep, n, hs, ha, pke) ]->
  [ Out(<sign(<'tok', S, ep, n, hs, ha, h(cust), pke>, skH), aenc(<'share', S, ep, n, p>, pke)>) ]

rule Platform_Accept_1:
  [ Waiting1(S, ep, nxt, n, e, hs, ha), !Cfg(S, H1, H2, I),
    !PkH(H1, pk1), !PkH(H2, pk2), !PkI(I, pkI),
    In(<sig1, sig2, cust>) ]
  --[ Eq(verify(cust, <'cust', S, ep, n>, pkI), true),
      Eq(verify(sig1, <'tok', S, ep, n, hs, ha, h(cust), pk(e)>, pk1), true),
      Eq(verify(sig2, <'tok', S, ep, n, hs, ha, h(cust), pk(e)>, pk2), true),
      Accept(S, ep, n),
      AcceptBy(S, H1, H2, I, ep, n, hs, ha, pk(e)) ]->
  [ Ep2(S, nxt) ]

rule Platform_Accept_2:
  [ Waiting2(S, ep, n, e, hs, ha), !Cfg(S, H1, H2, I),
    !PkH(H1, pk1), !PkH(H2, pk2), !PkI(I, pkI),
    In(<sig1, sig2, cust>) ]
  --[ Eq(verify(cust, <'cust', S, ep, n>, pkI), true),
      Eq(verify(sig1, <'tok', S, ep, n, hs, ha, h(cust), pk(e)>, pk1), true),
      Eq(verify(sig2, <'tok', S, ep, n, hs, ha, h(cust), pk(e)>, pk2), true),
      Accept(S, ep, n),
      AcceptBy(S, H1, H2, I, ep, n, hs, ha, pk(e)) ]->
  [ ]

restriction Eq: "All x y #i. Eq(x, y) @ i ==> x = y"
restriction Neq: "All x y #i. Neq(x, y) @ i ==> not (x = y)"
restriction Once: "All S #i #j. Once(S) @ i & Once(S) @ j ==> #i = #j"
restriction OneHolderKey: "All H #i #j. HolderInit(H) @ i & HolderInit(H) @ j ==> #i = #j"
restriction OneIssuerKey: "All I #i #j. IssuerInit(I) @ i & IssuerInit(I) @ j ==> #i = #j"

lemma executable: exists-trace
  "Ex S ep n #i. Accept(S, ep, n) @ i & not (Ex H #r. CorruptH(H) @ r)
   & not (Ex I #r. CorruptI(I) @ r) & not (Ex S2 #r. CorruptAK(S2) @ r)"

lemma executable_two_episodes: exists-trace
  "Ex S ep1 ep2 n1 n2 #i #j. Accept(S, ep1, n1) @ i & Accept(S, ep2, n2) @ j & #i < #j
   & not (Ex H #r. CorruptH(H) @ r) & not (Ex I #r. CorruptI(I) @ r) & not (Ex S2 #r. CorruptAK(S2) @ r)"

/* 토큰 일회성: 한 epoch 에서는 한 번만 받아들여진다 */
lemma token_one_time:
  "All S ep n1 n2 #i #j. Accept(S, ep, n1) @ i & Accept(S, ep, n2) @ j ==> #i = #j"

/* 관리권 증명 결속 */
lemma custody_bound:
  "All S H1 H2 I ep n hs ha pe #i. AcceptBy(S, H1, H2, I, ep, n, hs, ha, pe) @ i ==>
     (Ex #j. CustodyRegained(I, S, ep, n) @ j & #j < #i) | (Ex #r. CorruptI(I) @ r)"

/* 임계 인가: 받아들인 회차의 항해 상황·측정 상태·임시 키에 두 보유자가 모두 서명했다 */
lemma threshold_authorisation:
  "All S H1 H2 I ep n hs ha pe #i. AcceptBy(S, H1, H2, I, ep, n, hs, ha, pe) @ i ==>
     ((Ex #j. HolderSigned(H1, S, ep, n, hs, ha, pe) @ j & #j < #i) | (Ex #r. CorruptH(H1) @ r))
   & ((Ex #j. HolderSigned(H2, S, ep, n, hs, ha, pe) @ j & #j < #i) | (Ex #r. CorruptH(H2) @ r))"

/* 키 비밀성: 보유자 둘이 모두 훼손되거나 플랫폼 증명 키가 훼손되지 않는 한 공격자는 K_e 를 모른다 */
lemma ke_secrecy:
  "All S H1 H2 k #i. KeyOf(S, H1, H2, k) @ i ==>
     not (Ex #j. K(k) @ j)
     | (Ex #r1 #r2. CorruptH(H1) @ r1 & CorruptH(H2) @ r2)
     | (Ex #a. CorruptAK(S) @ a)"

/* 대조용(거짓이어야 정상): AK 훼손 조건을 빼면 반례가 나와야 한다.
   AK 를 쥔 공격자는 자기 임시 키로 요청을 위조하고, 보유자는 관리권 증명이 유효하면 조각을 내준다. */
lemma ke_secrecy_without_ak_condition:
  "All S H1 H2 k #i. KeyOf(S, H1, H2, k) @ i ==>
     not (Ex #j. K(k) @ j)
     | (Ex #r1 #r2. CorruptH(H1) @ r1 & CorruptH(H2) @ r2)"

/* 대조용(거짓이어야 정상): 보유자 한 명만 훼손되어도 비밀이 지켜지는지가 아니라,
   두 명 모두 훼손되면 비밀이 깨지는지(조건이 실제로 필요한지)를 본다 */
lemma ke_leaks_if_both_holders_corrupt: exists-trace
  "Ex S H1 H2 k #i #j. KeyOf(S, H1, H2, k) @ i & K(k) @ j & not (Ex S2 #a. CorruptAK(S2) @ a)"

end
